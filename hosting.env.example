# =============================================================================
# 9Associates — Production environment template (cPanel / shared hosting)
# =============================================================================
# cPanel often hides dotfiles. Upload this file, then rename it to ".env":
#   Terminal:  cp hosting.env.example .env
#   File Mgr:  Settings → Show Hidden Files → rename to .env
#
# NEVER commit the real .env file. Rotate any credentials that were exposed.
# =============================================================================

APP_NAME="9Associates"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://9associates.com
ADMIN_SECRET_PATH=change-this-to-a-secret-path

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database: Supabase PostgreSQL (recommended) ---
DB_CONNECTION=pgsql
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_SSLMODE=require

# Optional single connection string from Supabase → Settings → Database:
# DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# --- Legacy MySQL (only needed while migrating data to Supabase) ---
# MYSQL_SOURCE_HOST=127.0.0.1
# MYSQL_SOURCE_PORT=3306
# MYSQL_SOURCE_DATABASE=your_old_database
# MYSQL_SOURCE_USERNAME=your_old_user
# MYSQL_SOURCE_PASSWORD=your_old_password

# --- Supabase Auth (admin login verification) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_AUTH_ENABLED=true
SUPABASE_ADMIN_EMAILS=admin@9associates.com

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@9associates.com"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_FORM_EMAIL=contact@9associates.com
IT_SUPPORT_EMAIL=support@9associates.com
JOB_NOTIFICATION_EMAIL=careers@9associates.com

VITE_APP_NAME="${APP_NAME}"
