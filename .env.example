APP_NAME="9Associates"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ADMIN_SECRET_PATH=secure-admin-9a2024

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development (SQLite):
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Production MySQL (cPanel):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=your_database
# DB_USERNAME=your_username
# DB_PASSWORD=your_password

# Supabase PostgreSQL (recommended for production):
# DB_CONNECTION=pgsql
# DB_HOST=db.YOUR_PROJECT_REF.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=your_supabase_db_password
# DB_SSLMODE=require
# DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Legacy MySQL source (only while copying data to Supabase):
# MYSQL_SOURCE_HOST=127.0.0.1
# MYSQL_SOURCE_PORT=3306
# MYSQL_SOURCE_DATABASE=your_old_database
# MYSQL_SOURCE_USERNAME=your_old_user
# MYSQL_SOURCE_PASSWORD=your_old_password

# Supabase Auth — admin login verification:
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_AUTH_ENABLED=true
# SUPABASE_ADMIN_EMAILS=admin@9associates.com

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_FORM_EMAIL=contact@example.com
IT_SUPPORT_EMAIL=support@example.com
JOB_NOTIFICATION_EMAIL=careers@example.com

VITE_APP_NAME="${APP_NAME}"
